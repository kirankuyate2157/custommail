datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// audit model prisma
model Audit {
  id        String   @id @default(cuid())
  userId    String
  emailId   String?
  action    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  email     Email?   @relation(fields: [emailId], references: [id])
}


// campaign model prisma
model Campaign {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  status    String   @default("draft") // draft, running, completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  emails    Email[]
}


// contact model prisma
model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}


// email model prisma
model Email {
  id          String     @id @default(cuid())
  userId      String
  tenantId    String
  subject     String
  body        String
  status      String     @default("draft") // draft, sent, failed
  sentAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id])
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  templates   Template[]
  audits      Audit[]
}


// session model prisma
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}


// template model prisma
model Template {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  emails    Email[]
}


// tenant model prisma
model Tenant {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  campaigns Campaign[]
}


model User {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  email       String    @unique
  password    String
  role        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  emails      Email[]
  sessions    Session[]
  audits      Audit[]
}

