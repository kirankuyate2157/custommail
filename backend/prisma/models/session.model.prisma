model Session {
  id          String    @id @default(uuid())
  user_id     String
  tenant_id   String
  ip_address  String?
  device_info String?
  created_at  DateTime  @default(now())
  expires_at  DateTime?
  is_active   Boolean   @default(true)

  user   User         @relation(fields: [user_id], references: [id])
  tenant Tenant       @relation(fields: [tenant_id], references: [id])
  logs   SessionLog[]
}
