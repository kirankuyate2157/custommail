// session model prisma
model Session {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  ipAddress String
  isActive Boolean
  createdAt DateTime @default(now())
  expiresAt DateTime
}

