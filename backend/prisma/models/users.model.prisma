model Users {
  user_id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String?   @db.Uuid
  email         String    @unique @db.VarChar(255)
  full_name     String?   @db.VarChar(255)
  username      String?   @unique @db.VarChar(100)
  password_hash String?   @db.VarChar(255)
  auth_provider String?   @db.VarChar(50)
  role          String?   @default("user") @db.VarChar(50)
  status        String?   @db.VarChar(50)
  last_login_at DateTime?
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @updatedAt @db.Timestamp(6)

  tenant           Tenant?         @relation(fields: [tenant_id], references: [id])
  userOrgMap       UserOrgMap[]
  sessions         Session[]
  adminAuditLogs   AdminAuditLog[]
  mailAccounts     MailAccount[]
  syncAudits       SyncAudit[]
  contacts_added   Contact[]       @relation("AddedBy")
  imports_uploaded Import[]        @relation("UploadedBy")
  emailTemplates   EmailTemplate[]
  emailCampaigns   EmailCampaign[]
  tenantPolicies   TenantPolicy[]
  activities       Activity[]
  tenantAdminOf    Tenant[]        @relation("TenantAdmin")
  AuditLogs        AuditLogs[]
  Email            Email[]
  EmailOutbox      EmailOutbox[]

  @@index([email])
  @@index([tenant_id])
  @@index([role])
}
