model EmailMessage {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String    @db.Uuid
  campaign_id         String?   @db.Uuid
  mail_account_id     String?   @db.Uuid
  message_id          String?   @db.VarChar(255)
  thread_id           String?   @db.VarChar(255)
  provider_thread_id  String?   @db.VarChar(255)
  provider_message_id String?   @db.VarChar(255)
  recipient_email     String?   @db.VarChar(255)
  subject             String?   @db.VarChar(512)
  body_html           String?   @db.Text
  body_text           String?   @db.Text
  direction           String?   @db.VarChar(50)
  status              String?   @db.VarChar(50)
  sent_at             DateTime?
  delivered_at        DateTime?
  opened_at           DateTime?
  clicked_at          DateTime?
  replied_at          DateTime?
  bounce_reason       String?   @db.VarChar(255)
  raw_headers         String?   @db.Text
  provider_response   Json?
  created_at          DateTime  @default(now()) @db.Timestamp(6)
  updated_at          DateTime  @updatedAt @db.Timestamp(6)

  tenant         Tenant         @relation(fields: [tenant_id], references: [id])
  campaign       EmailCampaign? @relation(fields: [campaign_id], references: [id])
  mailAccount    MailAccount?   @relation(fields: [mail_account_id], references: [id])
  inboundReplies InboundReply[]
  emailEvents    EmailEvent[]
  bounceReports  BounceReport[]

  @@index([tenant_id])
  @@index([recipient_email])
  @@index([provider_message_id])
  @@index([created_at])
}
