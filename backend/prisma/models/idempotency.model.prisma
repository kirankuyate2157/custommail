model Idempotency {
  key         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  namespace   String    @db.VarChar(255)
  status_code Int?
  response    Json?
  headers     Json?
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @db.Timestamp(6)

  @@index([namespace])
  @@index([status_code])
  @@index([created_at])
}
