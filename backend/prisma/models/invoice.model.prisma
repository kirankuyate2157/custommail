model Invoice {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_billing_id String    @db.Uuid
  amount            Decimal   @db.Decimal(18, 2)
  currency          String?   @default("USD") @db.VarChar(10)
  status            String    @default("PAID") @db.VarChar(50)
  invoice_date      DateTime  @default(now()) @db.Timestamp(6)
  due_date          DateTime?
  paid_date         DateTime?
  payment_ref       String?   @db.VarChar(255)
  metadata          Json?
  created_at        DateTime  @default(now()) @db.Timestamp(6)

  tenantBilling TenantBilling @relation(fields: [tenant_billing_id], references: [id])
  Tenant        Tenant?       @relation(fields: [tenantId], references: [id])
  tenantId      String?       @db.Uuid

  @@index([tenant_billing_id])
  @@index([status])
  @@index([invoice_date])
}
