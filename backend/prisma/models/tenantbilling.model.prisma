model TenantBilling {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String    @db.Uuid
  billing_plan_id String    @db.Uuid
  start_date      DateTime  @default(now()) @db.Timestamp(6)
  end_date        DateTime?
  renewal_date    DateTime?
  status          String    @default("ACTIVE") @db.VarChar(50)
  payment_status  String    @default("PAID") @db.VarChar(50)
  payment_method  String?   @db.VarChar(50)
  last_invoice_id String?   @db.VarChar(255)
  auto_renew      Boolean   @default(true)
  usage_metrics   Json?
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  billingPlan BillingPlan @relation(fields: [billing_plan_id], references: [id])
  invoices    Invoice[]

  @@unique([tenant_id, billing_plan_id])
  @@index([tenant_id])
  @@index([billing_plan_id])
  @@index([status])
}
