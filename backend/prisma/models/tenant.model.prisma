// tenant model prisma
model Tenant {
  id          String   @id @default(uuid())
  name        String
  domain      String
  users       User[]
  policies    TenantPolicy[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  defaultAdmin User?   @relation("TenantAdmin", fields: [defaultAdminUserId], references: [id])
  defaultAdminUserId String?
}
