model MailAccount {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String    @db.Uuid
  user_id                 String    @db.Uuid
  provider_id             String?   @db.Uuid
  email_address           String?   @db.VarChar(255)
  display_name            String?   @db.VarChar(255)
  access_type             String?   @db.VarChar(50)
  encrypted_access_token  String?   @db.Text
  encrypted_refresh_token String?   @db.Text
  token_expires_at        DateTime?
  smtp_username           String?   @db.VarChar(255)
  encrypted_smtp_password String?   @db.Text
  imap_settings           Json?
  is_primary              Boolean   @default(false)
  status                  String?   @db.VarChar(50)
  last_connected_at       DateTime?
  created_at              DateTime  @default(now()) @db.Timestamp(6)
  updated_at              DateTime  @updatedAt @db.Timestamp(6)

  tenant         Tenant         @relation(fields: [tenant_id], references: [id])
  user           Users          @relation(fields: [user_id], references: [user_id])
  provider       MailProvider?  @relation(fields: [provider_id], references: [id])
  syncAudits     SyncAudit[]
  inboundReplies InboundReply[]
  emailMessages  EmailMessage[]

  @@index([tenant_id])
  @@index([user_id])
  @@index([email_address])
  @@index([is_primary])
}
